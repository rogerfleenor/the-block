# the-block — environment toggles
# Copy this file to `.env` and edit. All values are optional;
# every provider defaults to a deterministic mock so the app runs with zero keys.

# ─── Server ───────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=5173
LOG_LEVEL=info               # trace | debug | info | warn | error

# ─── AuctionAgent LLM ─────────────────────────────────────────────────────────
# Default is a rule-based intent router (no keys, no network).
AGENT_LLM=mock               # mock | openai | anthropic | ollama
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ─── Valuation providers ──────────────────────────────────────────────────────
KBB_LIVE=0
# KBB_API_KEY=
MANHEIM_LIVE=0
# MANHEIM_API_KEY=
ADESA_LIVE=0
# ADESA_API_KEY=
BLACKBOOK_LIVE=0
# BLACKBOOK_API_KEY=
JDPOWER_LIVE=0
# JDPOWER_API_KEY=
EDMUNDS_VALUES_LIVE=0
# EDMUNDS_API_KEY=

# ─── History / title / theft ──────────────────────────────────────────────────
CARFAX_LIVE=0
# CARFAX_API_KEY=
AUTOCHECK_LIVE=0
# AUTOCHECK_API_KEY=
NMVTIS_LIVE=0
# NMVTIS_API_KEY=
NICB_LIVE=0
VINAUDIT_LIVE=0
# VINAUDIT_API_KEY=

# ─── Specs / VIN decode ───────────────────────────────────────────────────────
NHTSA_VPIC_LIVE=0            # public, no key required
DATAONE_LIVE=0
# DATAONE_API_KEY=
MARTI_LIVE=0
MONRONEY_LIVE=0

# ─── Safety & recalls ─────────────────────────────────────────────────────────
NHTSA_RECALLS_LIVE=0         # public, no key required
NHTSA_NCAP_LIVE=0            # public, no key required
IIHS_LIVE=0

# ─── Auction & market comps ───────────────────────────────────────────────────
COPART_LIVE=0
IAA_LIVE=0
MARKETCHECK_LIVE=0
# MARKETCHECK_API_KEY=
VAUTO_LIVE=0

# ─── Dealer / DMS / inventory ─────────────────────────────────────────────────
CDK_FORTELLIS_LIVE=0
# CDK_FORTELLIS_API_KEY=
REYNOLDS_LIVE=0
DEALERTRACK_LIVE=0

# ─── Registration / ownership ─────────────────────────────────────────────────
POLK_LIVE=0
DMV_LIVE=0

# ─── Liens, repo, legal ───────────────────────────────────────────────────────
RDN_REPO_LIVE=0
LEXIS_LIENS_LIVE=0
COURT_VIOLATIONS_LIVE=0

# ─── Fuel & emissions ─────────────────────────────────────────────────────────
FUELECONOMY_LIVE=0           # public, no key required
EPA_GREEN_LIVE=0             # public, no key required

# ─── Social / reviews ─────────────────────────────────────────────────────────
YOUTUBE_LIVE=0
# YOUTUBE_API_KEY=
REDDIT_LIVE=0
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
TIKTOK_LIVE=0
INSTAGRAM_LIVE=0
X_LIVE=0
# X_BEARER_TOKEN=
EDMUNDS_REVIEWS_LIVE=0
CARSDOTCOM_REVIEWS_LIVE=0

# ─── Photography ──────────────────────────────────────────────────────────────
SPINCAR_LIVE=0

# ─── Frontend ─────────────────────────────────────────────────────────────────
# When set to 1, the web app uses MSW for ALL requests (zero-backend static build).
VITE_USE_MSW=0
VITE_API_BASE=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
